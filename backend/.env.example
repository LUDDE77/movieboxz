# =============================================================================
# MovieBoxZ Backend — Environment Variables
# Copy this file to .env and fill in your own values.
# NEVER commit .env to git.
# =============================================================================

# -----------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# -----------------------------------------------------------------------
# Supabase (get from supabase.com → Project Settings → API)
# -----------------------------------------------------------------------
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

# -----------------------------------------------------------------------
# YouTube Data API v3 (get from console.cloud.google.com)
# Quota: 10,000 units/day. Use playlistItems (1 unit) not search (100 units).
# -----------------------------------------------------------------------
YOUTUBE_API_KEY=your_youtube_api_key
YOUTUBE_API_KEY_SECONDARY=your_secondary_youtube_api_key_optional

# -----------------------------------------------------------------------
# TMDB — The Movie Database (get from themoviedb.org/settings/api)
# -----------------------------------------------------------------------
TMDB_API_KEY=your_tmdb_api_key
TMDB_READ_ACCESS_TOKEN=your_tmdb_read_access_token

# -----------------------------------------------------------------------
# OMDB — Open Movie Database (get from omdbapi.com)
# -----------------------------------------------------------------------
OMDB_API_KEY=your_omdb_api_key

# -----------------------------------------------------------------------
# Admin API Key — shared secret for the macOS Admin app
# Generate a strong random key: openssl rand -hex 32
# Set the same value in the macOS Admin app Preferences (Cmd+,)
# -----------------------------------------------------------------------
ADMIN_API_KEY=generate_with_openssl_rand_hex_32
